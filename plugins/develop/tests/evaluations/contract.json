{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Select $defs.fixture or $defs.result. evaluation.py additionally enforces path safety, unique/complete attempt IDs, evidence and state consistency. No remote schema resolution.",
  "$defs": {
    "fixture": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "scenario_ref": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "content"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            }
          },
          "required": [
            "prompt",
            "inputs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "id",
        "revision",
        "scenario_ref",
        "agent"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "synthetic",
            "offline",
            "live"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "(?:[0-9a-f]{40}|[0-9a-f]{64})"
            }
          },
          "required": [
            "repository",
            "revision"
          ],
          "additionalProperties": false
        },
        "host": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "minLength": 1
            },
            "selection_basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version",
            "model",
            "effort",
            "selection_basis"
          ],
          "additionalProperties": false
        },
        "grader_isolation": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "verified",
                "unverified"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "basis"
          ],
          "additionalProperties": false
        },
        "planned_attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "attempt_id": {
                "type": "string",
                "minLength": 1
              },
              "fixture": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "[0-9a-f]{64}"
                  }
                },
                "required": [
                  "id",
                  "revision",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "attempt_id",
              "fixture"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "attempt_id": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "enum": [
                  "completed",
                  "blocked",
                  "missing"
                ]
              },
              "reason": {
                "type": "string"
              },
              "functional": {
                "type": "object",
                "properties": {
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "fail",
                      "not_run"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "verdict",
                  "evidence"
                ],
                "additionalProperties": false
              },
              "evaluator": {
                "type": "object",
                "properties": {
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "fail",
                      "not_run"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "verdict",
                  "evidence"
                ],
                "additionalProperties": false
              },
              "observations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "channel": {
                      "type": "string",
                      "enum": [
                        "user",
                        "tool",
                        "helper"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "channel",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "cost": {
                "type": "object",
                "properties": {
                  "wall_seconds": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "tokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "usd": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  }
                },
                "required": [
                  "wall_seconds",
                  "tokens",
                  "usd"
                ],
                "additionalProperties": false
              },
              "application_performance": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "number",
                      "minimum": 0
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name",
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "attempt_id",
              "state",
              "reason",
              "functional",
              "evaluator",
              "observations",
              "cost",
              "application_performance"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "evidence_kind",
        "source",
        "host",
        "grader_isolation",
        "planned_attempts",
        "attempts"
      ],
      "additionalProperties": false
    }
  }
}
