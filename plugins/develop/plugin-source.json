{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "develop",
  "version": "0.10.0",
  "license": "Apache-2.0",
  "description": "Implement and verify repository changes. Run maintenance skills by name.",
  "author": {
    "name": "justinthelaw",
    "url": "https://github.com/justinthelaw"
  },
  "homepage": "https://github.com/justinthelaw/law-config/tree/main/plugins/develop",
  "repository": "https://github.com/justinthelaw/law-config.git",
  "keywords": [
    "development",
    "repositories",
    "upgrades",
    "review",
    "kaizen"
  ],
  "extensions": {
    "com.openai": {
      "hooks": "./hooks/hooks.json",
      "interface": {
        "displayName": "Develop",
        "logo": "./assets/logo.png",
        "composerIcon": "./assets/logo.png",
        "brandColor": "#C99554",
        "shortDescription": "Build, review, and improve",
        "longDescription": "Develop verifies changes through their callers. Iterate handles delivery. Invoke Upgrade, Upgrade Codex, Kaizen, Clean or Deep Clean by name. Trusted local hooks can bound large tool output.",
        "developerName": "justinthelaw",
        "category": "Developer Tools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://github.com/justinthelaw/law-config/tree/main/plugins/develop",
        "defaultPrompt": [
          "$develop:develop Fix this repository\u2019s failing build.",
          "$develop:upgrade Assess this repository\u2019s dependencies.",
          "$develop:kaizen Review these selected sessions."
        ]
      }
    }
  }
}
