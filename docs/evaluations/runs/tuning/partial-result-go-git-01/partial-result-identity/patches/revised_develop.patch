+// Canonical returns the canonical mode used when Git reads a tree entry.
+// Regular files become Regular or Executable according to the owner execute
+// bit. Directories and symlinks become Dir and Symlink; all other types,
+// including Empty and unrecognized types, become Submodule. Canonical does
+// not validate the mode.
+func (m FileMode) Canonical() FileMode {
+	switch m & 0o170000 {
+	case 0o040000:
+		return Dir
+	case 0o100000:
+		if m&0o100 != 0 {
+			return Executable
+		}
+		return Regular
+	case 0o120000:
+		return Symlink
+	default:
+		return Submodule
+	}
+}
