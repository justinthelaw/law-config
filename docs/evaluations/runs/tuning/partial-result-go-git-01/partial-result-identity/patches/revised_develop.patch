+func TestTreeDecodeOctalModes(t *testing.T) {
+	t.Parallel()
+	hash := bytes.Repeat([]byte{0xAA}, 20)
+	cases := []struct {
+		name string
+		mode string
+		want filemode.FileMode
+	}{
+		{"regular", "100644", filemode.Regular},
+		{"deprecated", "100664", filemode.Regular},
+		{"owner execute", "100744", filemode.Executable},
+		{"group execute", "100654", filemode.Regular},
+		{"other execute", "100645", filemode.Regular},
+		{"group and other execute", "100655", filemode.Regular},
+		{"directory", "40755", filemode.Dir},
+		{"symlink", "120777", filemode.Symlink},
+		{"submodule", "160755", filemode.Submodule},
+		{"unknown type", "140000", filemode.Submodule},
+		{"zero", "0", filemode.Submodule},
+		{"padded", "00000000000100644", filemode.Regular},
+		{"wide uint32", "20000100644", filemode.Regular},
+		{"wrapped uint32", "40000100644", filemode.Regular},
+		{"wide executable", "777777777777777777777777777777100755", filemode.Executable},
+		{"mode ends at buffer boundary", strings.Repeat("0", 4096-6) + "100644", filemode.Regular},
+		{"mode crosses buffers", strings.Repeat("0", 8192) + "100755", filemode.Executable},
+		{"nonzero mode crosses buffers", strings.Repeat("7", 8192) + "100655", filemode.Regular},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			tree, err := decodeRawTree(t, encodeRawTreeEntries(
+				rawTreeEntry{tc.mode, "a", hash},
+				rawTreeEntry{"100644", "z", hash},
+			))
+			require.NoError(t, err)
+			require.Len(t, tree.Entries, 2)
+			assert.Equal(t, tc.want, tree.Entries[0].Mode)
+			assert.Equal(t, "a", tree.Entries[0].Name)
+			assert.Equal(t, plumbing.NewHash("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), tree.Entries[0].Hash)
+			assert.Equal(t, filemode.Regular, tree.Entries[1].Mode)
+			assert.Equal(t, "z", tree.Entries[1].Name)
+			encoded := &plumbing.MemoryObject{}
+			require.NoError(t, tree.Encode(encoded))
+			var decoded Tree
+			require.NoError(t, decoded.Decode(encoded))
+			assert.Equal(t, tree.Entries, decoded.Entries)
+		})
+	}
+}
