+func TestTreeDecodeInvalidOctalModes(t *testing.T) {
+	t.Parallel()
+	hash := bytes.Repeat([]byte{0xAA}, 20)
+	for _, mode := range []string{
+		"", "8", "100648", "+100644", "-100644", "0x81a4", "100644\x00", "100644\xff",
+		strings.Repeat("0", 8192) + "8",
+		strings.Repeat("7", 4096) + "x100644",
+	} {
+		// Keep subtest names short for the multi-buffer cases.
+		t.Run(fmt.Sprintf("length_%d_suffix_%x", len(mode), []byte(mode[max(0, len(mode)-8):])), func(t *testing.T) {
+			_, err := decodeRawTree(t, encodeRawTreeEntries(rawTreeEntry{mode, "file", hash}))
+			require.ErrorIs(t, err, ErrMalformedTree)
+		})
+	}
+	for _, mode := range []string{"100644", strings.Repeat("0", 8192), strings.Repeat("7", 4096)} {
+		_, err := decodeRawTree(t, []byte(mode))
+		require.ErrorIs(t, err, ErrMalformedTree)
+	}
