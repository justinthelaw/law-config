+func TestCanonical(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		mode FileMode
+		want FileMode
+	}{
+		{Regular, Regular}, {Deprecated, Regular}, {Executable, Executable},
+		{0o100000, Regular}, {0o100600, Regular}, {0o100654, Regular},
+		{0o100645, Regular}, {0o100655, Regular}, {0o100700, Executable},
+		{0o107777, Executable}, {Dir, Dir}, {0o047777, Dir},
+		{Symlink, Symlink}, {0o127777, Symlink},
+		{Submodule, Submodule}, {0o167777, Submodule},
+		{Empty, Submodule}, {0o010000, Submodule}, {0o020000, Submodule},
+		{0o060000, Submodule}, {0o140000, Submodule},
+		{0o20000100644, Regular}, {FileMode(^uint32(0)), Submodule},
+	} {
+		t.Run(fmt.Sprintf("%o", tc.mode), func(t *testing.T) {
+			got := tc.mode.Canonical()
+			if got != tc.want {
+				t.Errorf("Canonical() = %v, want %v", got, tc.want)
+			}
+			if got.Canonical() != got {
+				t.Errorf("Canonical() is not idempotent for %v", got)
+			}
+		})
+	}
+}
