+		{Executable, Executable}, {Symlink, Symlink}, {Submodule, Submodule},
+		{0o100000, Regular}, {0o100001, Regular}, {0o100010, Regular},
+		{0o100011, Regular}, {0o100100, Executable}, {0o104600, Regular},
+		{0o104700, Executable}, {0o040755, Dir}, {0o120777, Symlink},
