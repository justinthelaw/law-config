+func TestTreeDecodeOctalModes(t *testing.T) {
+	t.Parallel()
+	hash := bytes.Repeat([]byte{0xAA}, 20)
+	for _, tc := range []struct {
+		name string
+		mode string
+		want filemode.FileMode
+	}{
+		{"zero padded", "00000000100644", filemode.Regular},
+		{"group execute only", "100010", filemode.Regular},
+		{"other execute only", "100001", filemode.Regular},
+		{"owner execute only", "100100", filemode.Executable},
+		{"buffer spanning padding", strings.Repeat("0", 9000) + "100644", filemode.Regular},
+		{"buffer spanning digits", strings.Repeat("7", 9000) + "100100", filemode.Executable},
+		{"uint32 wrap", "40000100644", filemode.Regular},
+		{"uint32 max", "37777777777", filemode.Submodule},
+		{"zero", "0", filemode.Submodule},
+		{"directory", "40755", filemode.Dir},
+		{"symlink", "120777", filemode.Symlink},
+		{"submodule", "160755", filemode.Submodule},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			tree, err := decodeRawTree(t, encodeRawTreeEntries(
+				rawTreeEntry{tc.mode, "a", hash}, rawTreeEntry{"100644", "b", hash},
+			))
+			require.NoError(t, err)
+			require.Len(t, tree.Entries, 2)
+			assert.Equal(t, tc.want, tree.Entries[0].Mode)
+			assert.Equal(t, "a", tree.Entries[0].Name)
+			assert.Equal(t, hash, tree.Entries[0].Hash.Bytes())
+			assert.Equal(t, filemode.Regular, tree.Entries[1].Mode)
+			assert.Equal(t, "b", tree.Entries[1].Name)
+
+			encoded := &plumbing.MemoryObject{}
+			require.NoError(t, tree.Encode(encoded))
+			var roundTrip Tree
+			require.NoError(t, roundTrip.Decode(encoded))
+			assert.Equal(t, tree.Entries, roundTrip.Entries)
+		})
+	}
+}
+
+func TestTreeDecodeInvalidOctalModes(t *testing.T) {
+	t.Parallel()
+	hash := bytes.Repeat([]byte{0xAA}, 20)
+	for _, mode := range []string{"", "8", "100648", "+100644", "-100644", "100644\x00", "100644\xff", strings.Repeat("0", 9000) + "8"} {
+		t.Run(fmt.Sprintf("%q", mode[:min(len(mode), 20)]), func(t *testing.T) {
+			t.Parallel()
+			_, err := decodeRawTree(t, encodeRawTreeEntries(rawTreeEntry{mode, "a", hash}))
+			require.ErrorIs(t, err, ErrMalformedTree)
+		})
+	}
+	for _, mode := range []string{"100644", strings.Repeat("0", 9000), strings.Repeat("7", 9000)} {
+		_, err := decodeRawTree(t, []byte(mode))
+		require.ErrorIs(t, err, ErrMalformedTree)
+	}
+}
