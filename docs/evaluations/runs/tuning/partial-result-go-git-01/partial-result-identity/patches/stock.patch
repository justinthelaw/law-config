+
+// Canonical returns the mode Git uses when reading a tree entry. Directories
+// and symlinks lose their permission bits; regular files become Regular or
+// Executable according to the owner execute bit. All other types, including
+// Empty and unrecognized types, become Submodule.
+//
+// Canonical does not validate the original mode. Use IsMalformed to check
+// whether a mode is one of the constants defined by this package.
+func (m FileMode) Canonical() FileMode {
+	switch m & 0o170000 {
+	case 0o040000:
+		return Dir
+	case 0o100000:
+		if m&0o100 != 0 {
+			return Executable
+		}
+		return Regular
+	case 0o120000:
+		return Symlink
+	default:
+		return Submodule
+	}
+}
