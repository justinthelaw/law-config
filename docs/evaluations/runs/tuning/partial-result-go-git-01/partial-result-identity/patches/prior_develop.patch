+func TestTreeDecodeOctalModes(t *testing.T) {
+	t.Parallel()
+	hash := bytes.Repeat([]byte{0xAA}, 20)
+	for _, tc := range []struct {
+		name, mode string
+		want       filemode.FileMode
+	}{
+		{"regular", "100644", filemode.Regular},
+		{"deprecated", "100664", filemode.Regular},
+		{"group execute", "100654", filemode.Regular},
+		{"other execute", "100645", filemode.Regular},
+		{"owner execute", "100100", filemode.Executable},
+		{"padded", "00000000100644", filemode.Regular},
+		{"buffer boundary", strings.Repeat("0", 4090) + "100755", filemode.Executable},
+		{"multiple buffers", strings.Repeat("0", 10000) + "100644", filemode.Regular},
+		{"uint32 wrap", "40000100644", filemode.Regular},
+		{"wide wrap", strings.Repeat("7", 10000) + "00100755", filemode.Executable},
+		{"directory", "040755", filemode.Dir},
+		{"symlink", "120777", filemode.Symlink},
+		{"submodule", "160777", filemode.Submodule},
+		{"unknown type", "170000", filemode.Submodule},
+		{"zero", "00000000", filemode.Submodule},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			body := encodeRawTreeEntries(rawTreeEntry{tc.mode, "a", hash}, rawTreeEntry{"100644", "b", hash})
+			tree, err := decodeRawTree(t, body)
+			require.NoError(t, err)
+			require.Len(t, tree.Entries, 2)
+			assert.Equal(t, tc.want, tree.Entries[0].Mode)
+			assert.Equal(t, "a", tree.Entries[0].Name)
+			assert.Equal(t, plumbing.NewHash(strings.Repeat("aa", 20)), tree.Entries[0].Hash)
+			assert.Equal(t, filemode.Regular, tree.Entries[1].Mode)
+			var encoded plumbing.MemoryObject
+			require.NoError(t, tree.Encode(&encoded))
+			var decoded Tree
+			require.NoError(t, decoded.Decode(&encoded))
+			assert.Equal(t, tree.Entries, decoded.Entries)
+		})
+	}
+}
+
+func TestTreeDecodeInvalidOctalModes(t *testing.T) {
+	t.Parallel()
+	hash := bytes.Repeat([]byte{0xAA}, 20)
+	for _, mode := range []string{"", "8", "+100644", "-100644", "100644\x00", "100644\t", "x" + strings.Repeat("0", 10000), strings.Repeat("0", 10000) + "8"} {
+		_, err := decodeRawTree(t, encodeRawTreeEntries(rawTreeEntry{mode, "a", hash}))
+		require.ErrorIs(t, err, ErrMalformedTree, "mode length %d", len(mode))
+	}
+	for _, mode := range []string{"100644", strings.Repeat("0", 4096), strings.Repeat("7", 10000)} {
+		_, err := decodeRawTree(t, []byte(mode))
+		require.ErrorIs(t, err, ErrMalformedTree)
+	}
+}
