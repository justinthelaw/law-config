+func (s *ModeSuite) TestFromBytesUint32() {
+	for _, mode := range []FileMode{Empty, Dir, Regular, Deprecated, Executable, Symlink, Submodule, 0o7777777, 0o10000000, 0o37777777777} {
+		for _, input := range []string{mode.String(), strings.Repeat("0", 5000) + mode.String()} {
+			got, err := FromBytes([]byte(input))
+			s.Require().NoError(err)
+			s.Equal(mode, got)
+		}
+	}
+	for _, input := range []string{"40000000000", "100000000000", "00040000000000", "00000008", "+100644", "100644\x00", "100644 "} {
+		got, err := FromBytes([]byte(input))
+		s.Error(err, input)
+		s.Equal(Empty, got, input)
+	}
