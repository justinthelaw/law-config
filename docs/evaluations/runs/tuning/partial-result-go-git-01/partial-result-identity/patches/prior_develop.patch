+// Canonical returns the mode Git uses when reading a tree entry. Regular
+// files are executable only when the owner execute bit is set. Directory and
+// symlink permissions are discarded; all other types are treated as submodules.
+// Canonical does not validate the mode.
+func (m FileMode) Canonical() FileMode {
+	switch m & 0o170000 {
+	case 0o040000:
+		return Dir
+	case 0o100000:
+		if m&0o100 != 0 {
+			return Executable
+		}
+		return Regular
+	case 0o120000:
+		return Symlink
+	default:
+		return Submodule
+	}
+}
