+		{0o100000, Regular}, {0o100654, Regular}, {0o100645, Regular},
+		{0o100100, Executable}, {0o104700, Executable},
+		{Dir, Dir}, {0o040755, Dir}, {Symlink, Symlink}, {0o120777, Symlink},
+		{Submodule, Submodule}, {0o160755, Submodule},
+		{Empty, Submodule}, {0o42, Submodule}, {0o170000, Submodule},
+		{0x800081a4, Regular}, {0xffffffff, Submodule},
