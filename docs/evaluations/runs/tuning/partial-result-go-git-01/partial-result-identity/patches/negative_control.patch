+func TestTreeDecodeOctalModes(t *testing.T) {
+	t.Parallel()
+	hash := bytes.Repeat([]byte{0xaa}, 20)
+	for _, tc := range []struct {
+		name string
+		mode string
+		want filemode.FileMode
+	}{
+		{"group execute", "100654", filemode.Regular},
+		{"other execute", "100645", filemode.Regular},
+		{"owner execute", "100744", filemode.Executable},
+		{"zero padding", "00000000100644", filemode.Regular},
+		{"mode crosses buffers", strings.Repeat("0", 8192) + "100755", filemode.Executable},
+		{"uint32 wrap", "40000100644", filemode.Regular},
+		{"multiple wraps", strings.Repeat("7", 8192) + "100644", filemode.Regular},
+		{"wrapped directory", "40000040777", filemode.Dir},
+		{"wrapped symlink", "40000120777", filemode.Symlink},
+		{"wrapped submodule", "40000160777", filemode.Submodule},
+		{"zero", "0", filemode.Submodule},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			tree, err := decodeRawTree(t, encodeRawTreeEntries(rawTreeEntry{tc.mode, "a", hash}, rawTreeEntry{"100644", "z", hash}))
+			require.NoError(t, err)
+			require.Len(t, tree.Entries, 2)
+			assert.Equal(t, tc.want, tree.Entries[0].Mode)
+			assert.Equal(t, "a", tree.Entries[0].Name)
+			assert.Equal(t, plumbing.NewHash(strings.Repeat("aa", 20)), tree.Entries[0].Hash)
+			assert.Equal(t, filemode.Regular, tree.Entries[1].Mode)
+			obj := &plumbing.MemoryObject{}
+			require.NoError(t, tree.Encode(obj))
+			var decoded Tree
+			require.NoError(t, decoded.Decode(obj))
+			assert.Equal(t, tree.Entries, decoded.Entries)
+		})
+	}
+}
+
+func TestTreeDecodeRejectsInvalidOctalModes(t *testing.T) {
+	t.Parallel()
+	hash := bytes.Repeat([]byte{0xaa}, 20)
+	for i, mode := range []string{"", "+100644", "-100644", "100648", "10064\x00", "10064\xff", strings.Repeat("0", 8192) + "8"} {
+		t.Run(fmt.Sprintf("case %d", i), func(t *testing.T) {
+			_, err := decodeRawTree(t, encodeRawTreeEntries(rawTreeEntry{mode, "a", hash}))
+			require.ErrorIs(t, err, ErrMalformedTree)
+		})
+	}
+	for _, mode := range []string{"100644", strings.Repeat("0", 8192)} {
+		_, err := decodeRawTree(t, []byte(mode))
+		require.ErrorIs(t, err, ErrMalformedTree)
+	}
+}
