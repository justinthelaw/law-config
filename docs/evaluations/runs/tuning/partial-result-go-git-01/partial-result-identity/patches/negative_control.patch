+func (s *ModeSuite) TestCanonical() {
+	for _, tc := range []struct{ mode, want FileMode }{
+		{Regular, Regular}, {Deprecated, Regular}, {Executable, Executable},
+		{0o100000, Regular}, {0o100654, Regular}, {0o100645, Regular},
+		{0o100744, Executable}, {0o104000, Regular}, {0o104100, Executable},
+		{Dir, Dir}, {0o040777, Dir}, {Symlink, Symlink}, {0o120777, Symlink},
+		{Submodule, Submodule}, {0o160777, Submodule}, {Empty, Submodule},
+		{0o170000, Submodule}, {0o020000, Submodule},
+	} {
+		s.Equal(tc.want, tc.mode.Canonical(), "%o", tc.mode)
+		s.Equal(tc.want, tc.mode.Canonical().Canonical())
+	}
+}
