+func (s *ModeSuite) TestFromBytesUint32() {
+	for _, input := range []string{"37777777777", "0000037777777777"} {
+		mode, err := FromBytes([]byte(input))
+		s.NoError(err, input)
+		s.Equal(FileMode(0xffffffff), mode, input)
+	}
+	for _, mode := range []FileMode{Empty, Dir, Regular, Deprecated, Executable, Symlink, Submodule, 0xffffffff} {
+		decoded, err := FromBytes([]byte(strings.Repeat("0", 8192) + mode.String()))
+		s.NoError(err)
+		s.Equal(mode, decoded)
+	}
+	for _, input := range []string{"40000000000", "77777777777", "40000100644", "+100644", "100644\x00", "100644 ", "10064\xff", strings.Repeat("0", 8192) + "8"} {
+		mode, err := FromBytes([]byte(input))
+		s.Error(err, input)
+		s.Equal(Empty, mode, input)
+	}
+}
