  "probe": "const { readFileSync } = require(\"node:fs\");\nconst { createRequire } = require(\"node:module\");\nconst { pathToFileURL } = require(\"node:url\");\nconst load = createRequire(\"/work/package.json\");\nconst { Parser, HtmlRenderer } = load(\"commonmark\");\nconst markdownIt = load(\"markdown-it\")(\"commonmark\");\n\n(async () => {\n  const { marked } = await import(pathToFileURL(\"/work/lib/marked.esm.js\"));\n  const common = new Parser();\n  const html = new HtmlRenderer();\n  const specs = JSON.parse(readFileSync(\"/work/test/specs/commonmark/commonmark.0.31.2.json\"))\n    .filter(row => row.section === \"Emphasis and strong emphasis\");\n  const mismatchedSpec = specs.filter(row => marked.parse(row.markdown, { gfm: false }) !== row.html);\n  const observations = { official_examples: specs.length, official_mismatches: mismatchedSpec.map(row => row.example),\n    generated: 0, reference_disagreements: 0, differs_from_both: 0, shortest: [] };\n  let current = [\"\"];\n  for (let length = 1; length <= 6; length++) {\n    current = current.flatMap(prefix => [\"*\", \"_\", \"a\", \"!\"].map(c => prefix + c));\n    for (const form of current) {\n      if (!form.includes(\"a\") || (form.match(/[*_]/g) || []).length < 2) continue;\n      const input = \"x \" + form + \" x\";\n      const a = html.render(common.parse(input));\n      const b = markdownIt.renderInline(input);\n      observations.generated++;\n      if (a !== \"<p>\" + b + \"</p>\\n\") {\n        observations.reference_disagreements++;\n        continue;\n      }\n      const actual = marked.parseInline(input, { gfm: false });\n      if (actual !== b) {\n        observations.differs_from_both++;\n        if (observations.shortest.length < 3) observations.shortest.push({ input, expected: b, actual });\n      }\n    }\n  }\n  console.log(JSON.stringify(observations));\n})().catch(error => { console.error(error); process.exitCode = 1; });\n",
