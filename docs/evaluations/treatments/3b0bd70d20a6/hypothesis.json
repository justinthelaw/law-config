      "post_freeze_probe": {
        "scope": "Separate from the historical grades. The base and Develop reject literal parameter references in comments and processing instructions when the named entity has an overflowing expansion. The recorded control and merge accept both. All four safely reject the real chain and recursion. The shorter literal self-reference alone is accepted on all four.",
        "source": "\"\"\"Exercise literal and real parameter references in the public, DTD-enabled Expat parser.\"\"\"\nimport ctypes as C\nimport json\nfrom pathlib import Path\nimport resource\n\nresource.setrlimit(resource.RLIMIT_CPU, (10, 12))\nresource.setrlimit(resource.RLIMIT_AS, (256 << 20, 256 << 20))\nlib = C.CDLL(str(Path(\"build-panel/libexpat.so\").resolve()))\nfor fn, args, ret in (\n    (\"XML_ParserCreate\", [C.c_char_p], C.c_void_p),\n    (\"XML_SetParamEntityParsing\", [C.c_void_p, C.c_int], C.c_int),\n    (\"XML_Parse\", [C.c_void_p, C.c_char_p, C.c_int, C.c_int], C.c_int),\n    (\"XML_GetErrorCode\", [C.c_void_p], C.c_int),\n    (\"XML_ErrorString\", [C.c_int], C.c_char_p),\n    (\"XML_ParserFree\", [C.c_void_p], None),\n):\n    call = getattr(lib, fn)\n    call.argtypes, call.restype = args, ret\n\ndef check(declarations):\n    document = f\"<!DOCTYPE r [{declarations}]><r/>\".encode()\n    parser = lib.XML_ParserCreate(None)\n    assert parser and lib.XML_SetParamEntityParsing(parser, 2) == 1\n    try:\n        status = lib.XML_Parse(parser, document, len(document), 1)\n        code = lib.XML_GetErrorCode(parser)\n        return {\"accepted\": status == 1, \"error\": (lib.XML_ErrorString(code) or b\"\").decode()}\n    finally:\n        lib.XML_ParserFree(parser)\n\ndef declare(name, text):\n    return f'<!ENTITY % {name} \"{text}\">'\n\nchain = declare(\"b0\", \"<!--leaf-->\") + \"\".join(declare(f\"b{i}\", f\"&#37;b{i-1};\" * 2) for i in range(1, 65))\ncases = {\n    \"simple_comment\": declare(\"lit\", \"<!--text-->\") + \"%lit;\",\n    \"unused_chain\": chain,\n    \"literal_cycle_comment\": declare(\"lit\", \"<!--&#37;lit;-->\") + \"%lit;\",\n    \"literal_cycle_pi\": declare(\"lit\", \"<?q &#37;lit;?>\") + \"%lit;\",\n    \"literal_chain_comment\": chain + declare(\"lit\", \"<!--&#37;b64;-->\") + \"%lit;\",\n    \"literal_chain_pi\": chain + declare(\"lit\", \"<?q &#37;b64;?>\") + \"%lit;\",\n    \"real_cycle\": declare(\"lit\", \"&#37;lit;\") + \"%lit;\",\n    \"real_chain\": chain + \"%b64;\",\n}\nfor name, xml in cases.items():\n    print(json.dumps({\"case\": name, **check(xml)}), flush=True)\n",
