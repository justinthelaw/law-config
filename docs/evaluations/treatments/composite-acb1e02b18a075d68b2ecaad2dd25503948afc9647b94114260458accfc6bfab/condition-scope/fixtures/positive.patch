+def test_response_conversion_closes_on_failure():
+    class Broken(SizedResponseIterable):
+        def __iter__(self):
+            yield b"a"
+            raise ValueError("broken iterable")
+
+    source = Broken()
+    response = wrappers.Response(source)
+    with pytest.raises(ValueError, match="broken iterable"):
+        response.make_sequence()
+    assert source.close_count == 1
+    assert response.response is source
