+class SizedResponseIterable:
+    def __init__(self):
+        self.close_count = 0
+        self.iter_count = 0
+
+    def __len__(self):
+        return 2
+
+    def __iter__(self):
+        self.iter_count += 1
+        yield b"a"
+        yield b"bc"
+
+    def close(self):
+        self.close_count += 1
+
+
+def test_response_sized_stream():
+    source = SizedResponseIterable()
+    response = wrappers.Response(source)
+    assert response.is_streamed
+    assert not response.is_sequence
+    assert "Content-Length" not in response.get_wsgi_headers({})
+    assert "streamed" in repr(response)
+    assert source.iter_count == 0
+    assert response.get_data() == b"abc"
+    assert source.close_count == 1
+    assert response.is_sequence
+    assert response.get_wsgi_headers({})["Content-Length"] == "3"
+    response.close()
+    assert source.close_count == 1
+
+
+@pytest.mark.parametrize(
+    "operation",
+    ["make_sequence", "freeze", "mutable", "get_data", "calculate_content_length"],
+)
+@pytest.mark.parametrize("sequence", [False, True])
+def test_response_conversion_closes_original(operation, sequence):
+    class ClosableSequence(UserList):
+        close_count = 0
+
+        def close(self):
+            self.close_count += 1
+
+    source = ClosableSequence([b"a", b"bc"]) if sequence else SizedResponseIterable()
+    response = wrappers.Response(source)
+    closed = []
+    response.call_on_close(lambda: closed.append(True))
+    if operation == "mutable":
+        response._ensure_sequence(mutable=True)
+    else:
+        getattr(response, operation)()
+    converted = not sequence or operation in {"mutable", "make_sequence", "freeze"}
+    assert source.close_count == int(converted)
+    assert response.get_data() == b"abc"
+    assert not closed
+    response.close()
+    assert source.close_count == 1
+    assert closed == [True]
+
