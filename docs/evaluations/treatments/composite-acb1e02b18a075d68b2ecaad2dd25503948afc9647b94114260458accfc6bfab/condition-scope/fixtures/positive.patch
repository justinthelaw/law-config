+@pytest.mark.parametrize("factory", [list, tuple, UserList])
+def test_response_sequence_types(factory):
+    response = wrappers.Response(factory([b"a", b"bc"]))
+    assert response.is_sequence
+    assert not response.is_streamed
+    assert response.get_wsgi_headers({})["Content-Length"] == "3"
+    assert response.calculate_content_length() == 3
+    assert response.get_data() == b"abc"
+    assert "3 bytes" in repr(response)
+
