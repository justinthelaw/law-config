#!/usr/bin/env bash
#
# sanitize_shell_history.sh - Safely sanitize your Bash or Zsh history.
# Usage: ./sanitize_shell_history.sh <history_file>
# Example: ./sanitize_shell_history.sh ~/.zsh_history

set -euo pipefail

# Set locale to handle non-UTF-8 characters properly on macOS
export LC_ALL=C
export LANG=C

# Cleanup function
cleanup() {
  if [[ -n "${TMP_FILE:-}" ]]; then
    rm -f "$TMP_FILE" "${TMP_FILE}.new"
  fi
  if [[ -n "${SOURCE_FILE:-}" ]]; then
    rm -f "$SOURCE_FILE"
  fi
}
trap cleanup EXIT

# === Configuration ===
SENSITIVE_PATTERNS=(
  "password"
  "PASSWORD"
  "secret"
  "SECRET"
  "token"
  "TOKEN"
  "apikey"
  "APIKEY"
  "authorization"
  "AUTHORIZATION"
  "session"
  "SESSION"
  "arn:aws"
  "ARN:AWS"
)
# Patterns of failed/incorrect commands (expand as needed)
FAILED_PATTERNS=(
  "command not found"
  "No such file or directory"
  "syntax error"
  "not recognized as"
  "is not a function"
  "zsh:.*not found"
  "bash:.*not found"
)

# === Args and setup ===
if [[ $# -ne 1 ]]; then
  echo "Usage: $0 <history_file>"
  exit 1
fi
HIST_FILE="$1"
if [[ ! -f "$HIST_FILE" || -L "$HIST_FILE" ]]; then
  echo "Error: history_file must be a regular, non-symlink file: $HIST_FILE" >&2
  exit 1
fi
case "$HIST_FILE" in
*/*)
  HIST_DIR="${HIST_FILE%/*}"
  [[ -n "$HIST_DIR" ]] || HIST_DIR="/"
  ;;
*) HIST_DIR="." ;;
esac
# Keep a stable same-directory hard link to the original inode. This avoids
# reopening a path that can be replaced by a symlink while the pipeline runs.
SOURCE_FILE="$(mktemp "$HIST_DIR/.sanitize_source.XXXXXX")"
rm -f "$SOURCE_FILE"
if ! ln -P "$HIST_FILE" "$SOURCE_FILE" || [[ -L "$SOURCE_FILE" || ! -f "$SOURCE_FILE" ]]; then
  echo "Error: history_file must remain a regular, non-symlink file: $HIST_FILE" >&2
  exit 1
fi
if [[ -L "$HIST_FILE" || ! -f "$HIST_FILE" || ! "$HIST_FILE" -ef "$SOURCE_FILE" ]]; then
  echo "Error: history_file changed before sanitization: $HIST_FILE" >&2
  exit 1
fi
# Keep working files beside the history file so the final rename is atomic.
TMP_FILE="$(mktemp "$HIST_DIR/.sanitize_hist.XXXXXX")"

echo "[*] Sanitizing: $HIST_FILE ..."

grep_filter() {
  local output_file="$1"
  local status
  shift

  if "$@" >"$output_file"; then
    return 0
  else
    status=$?
  fi
  if [[ "$status" -eq 1 ]]; then
    return 0
  fi
  return "$status"
}

backup_history() {
  local epoch
  local candidate
  local counter=0

  epoch="$(date +%s)"
  candidate="${HIST_FILE}.bak.${epoch}"
  while [[ -e "$candidate" ]]; do
    counter=$((counter + 1))
    candidate="${HIST_FILE}.bak.${epoch}.$$.$counter"
  done

  BACKUP_FILE="$candidate"
  cp "$SOURCE_FILE" "$BACKUP_FILE"
}

# === Step 1: Normalize (remove timestamps, extra spaces) ===
normalize_history() {
  # Handles Zsh extended history lines with timestamps, strips them
  # Zsh extended: ': 1651737463:0;command here'
  # Use LC_ALL=C to handle binary/non-UTF-8 characters
  if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS (BSD sed) - use basic regex to avoid encoding issues
    LC_ALL=C sed 's/^: [0-9][0-9]*:[0-9][0-9]*;//' "$1" | LC_ALL=C sed 's/^[ 	]*//;s/[ 	]*$//'
  else
    # Linux (GNU sed)
    sed -E 's/^: [0-9]+:[0-9]+;//' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
  fi
}

# === Step 2: Remove sensitive lines ===
remove_sensitive() {
  local f="$1"
  local pattern
  for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    # Remove any lines containing the pattern (case-insensitive)
    # Use LC_ALL=C for macOS to handle encoding issues
    if [[ "$OSTYPE" == "darwin"* ]]; then
      # macOS grep - use LC_ALL=C
      grep_filter "${f}.new" env LC_ALL=C grep -v -i "$pattern" "$f"
    else
      # Linux grep
      grep_filter "${f}.new" grep -vi "$pattern" "$f"
    fi
    mv "${f}.new" "$f"
  done
}

# === Step 3: Remove failed/incorrect commands ===
remove_failed() {
  local f="$1"
  local pattern
  for pattern in "${FAILED_PATTERNS[@]}"; do
    # Use LC_ALL=C for macOS to handle encoding issues
    if [[ "$OSTYPE" == "darwin"* ]]; then
      # macOS grep - use LC_ALL=C and basic regex
      grep_filter "${f}.new" env LC_ALL=C grep -v "$pattern" "$f"
    else
      # Linux grep - can use extended regex
      grep_filter "${f}.new" grep -Ev "$pattern" "$f"
    fi
    mv "${f}.new" "$f"
  done
}

# === Step 3b: Remove commands ending with multiple semicolons ===
remove_multi_semicolon() {
  local f="$1"
  # Removes lines ending with two or more semicolons and nothing after
  grep_filter "${f}.new" env LC_ALL=C grep -Ev ';{2,}[[:space:]]*$' "$f"
  mv "${f}.new" "$f"
}

# === Step 4: Remove empty and whitespace lines ===
remove_empty() {
  local f="$1"
  if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS - use LC_ALL=C and simpler pattern
    grep_filter "${f}.new" env LC_ALL=C grep -v '^[ 	]*$' "$f"
  else
    # Linux
    grep_filter "${f}.new" grep -v '^[[:space:]]*$' "$f"
  fi
  mv "${f}.new" "$f"
}

# === Step 5: Deduplicate (keep last occurrence of each command) ===
dedupe_history() {
  # Keep the final copy of a command at the position where it last appeared.
  awk '{lines[NR]=$0; last[$0]=NR} END{for(i=1;i<=NR;i++)if(last[lines[i]]==i)print lines[i]}' "$1" >"${1}.new"
  mv "${1}.new" "$1"
}

# === Pipeline ===
backup_history
normalize_history "$SOURCE_FILE" >"$TMP_FILE"
remove_sensitive "$TMP_FILE"
remove_failed "$TMP_FILE"
remove_multi_semicolon "$TMP_FILE"
remove_empty "$TMP_FILE"
dedupe_history "$TMP_FILE"
if [[ -L "$HIST_FILE" || ! -f "$HIST_FILE" || ! "$HIST_FILE" -ef "$SOURCE_FILE" ]]; then
  echo "Error: history_file changed during sanitization; refusing to replace it: $HIST_FILE" >&2
  exit 1
fi
mv "$TMP_FILE" "$HIST_FILE"

echo "[+] Done. Backup: $BACKUP_FILE"
